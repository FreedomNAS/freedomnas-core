#!/usr/bin/make -f

# The core goes where every edition puts it: the package directory under
# /usr/lib/freedomnas/core, on sys.path through a .pth file. paths.py finds
# the profiles and the WebUI from there, which a wheel in dist-packages
# could not. dh_python3 byte-compiles that private directory at install
# time and removes the bytecode again with the package.
CORE_DIR = debian/freedomnas-core/usr/lib/freedomnas/core

%:
	dh $@ --with python3 --buildsystem=none

override_dh_auto_test:
	-python3 -m pytest tests/ -q 2>/dev/null || true

override_dh_install:
	dh_install
	install -d $(CORE_DIR)/freedomnas
	cp -r *.py modules $(CORE_DIR)/freedomnas/
	find $(CORE_DIR) -name __pycache__ -prune -exec rm -rf {} +
	install -d debian/freedomnas-core/usr/lib/python3/dist-packages
	echo /usr/lib/freedomnas/core > debian/freedomnas-core/usr/lib/python3/dist-packages/freedomnas-core.pth
	install -D -m 755 bin/freedomnas debian/freedomnas-core/usr/bin/freedomnas

override_dh_python3:
	dh_python3 /usr/lib/freedomnas/core --shebang=/usr/bin/python3
